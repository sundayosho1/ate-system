# ATE local development environment template.
# Copy to .env for local development only. Never commit real credentials.

ATE_RUNTIME_MODE=DEVELOPMENT
ATE_LOG_LEVEL=info

# Database credentials are intentionally placeholders for future prompts.
ATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# MT5/broker credentials must never be committed.
ATE_MT5_LOGIN=REPLACE_WITH_LOCAL_VALUE
ATE_MT5_PASSWORD=REPLACE_WITH_LOCAL_VALUE
ATE_MT5_SERVER=REPLACE_WITH_LOCAL_VALUE
